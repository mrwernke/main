{  "name": "CalendarSlot",  "type": "object",  "properties": {    "slot_date": {      "type": "string"    },    "start_time": {      "type": "string"    },    "end_time": {      "type": "string"    },    "status": {      "type": "string",      "enum": [        "open",        "pending",        "booked"      ],      "default": "open"    },    "student_id": {      "type": "string"    },    "student_name": {      "type": "string"    },    "zoom_link": {      "type": "string"    }  },  "required": [    "slot_date",    "start_time"  ]}