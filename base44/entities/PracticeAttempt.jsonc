{  "name": "PracticeAttempt",  "type": "object",  "properties": {    "student_id": {      "type": "string"    },    "student_name": {      "type": "string"    },    "question_id": {      "type": "string"    },    "topic": {      "type": "string"    },    "difficulty": {      "type": "string"    },    "selected_answer": {      "type": "string"    },    "correct": {      "type": "boolean"    }  },  "required": [    "student_id",    "question_id"  ]}