{  "name": "TestResult",  "type": "object",  "properties": {    "student_id": {      "type": "string"    },    "student_name": {      "type": "string"    },    "test_number": {      "type": "number"    },    "score": {      "type": "number"    },    "total_questions": {      "type": "number"    },    "correct_count": {      "type": "number"    },    "topic_breakdown": {      "type": "object",      "additionalProperties": true    },    "answers": {      "type": "array",      "items": {        "type": "object",        "additionalProperties": true      }    }  },  "required": [    "student_id",    "test_number"  ]}