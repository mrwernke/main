{  "name": "Student",  "type": "object",  "properties": {    "first_name": {      "type": "string"    },    "last_name": {      "type": "string"    },    "school": {      "type": "string"    },    "grade": {      "type": "string",      "enum": [        "9",        "10",        "11",        "12"      ]    },    "username": {      "type": "string"    },    "password": {      "type": "string"    },    "email": {      "type": "string"    },    "phone": {      "type": "string"    },    "parent_first_name": {      "type": "string"    },    "parent_last_name": {      "type": "string"    },    "parent_email": {      "type": "string"    },    "parent_phone": {      "type": "string"    },    "approval_status": {      "type": "string",      "enum": [        "pending",        "approved",        "rejected"      ],      "default": "pending"    },    "test1_unlocked": {      "type": "boolean",      "default": false    },    "test2_unlocked": {      "type": "boolean",      "default": false    },    "test3_unlocked": {      "type": "boolean",      "default": false    },    "psat_grade10_math": {      "type": "number"    },    "psat_grade11_math": {      "type": "number"    },    "sat_attempts": {      "type": "array",      "items": {        "type": "object",        "properties": {          "month": {            "type": "string"          },          "year": {            "type": "string"          },          "math_score": {            "type": "number"          }        }      }    }  },  "required": [    "first_name",    "last_name",    "username",    "password",    "email"  ]}