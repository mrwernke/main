{  "name": "Question",  "type": "object",  "properties": {    "question_text": {      "type": "string"    },    "question_type": {      "type": "string",      "enum": [        "multiple_choice",        "grid_in"      ],      "default": "multiple_choice"    },    "choice_a": {      "type": "string"    },    "choice_b": {      "type": "string"    },    "choice_c": {      "type": "string"    },    "choice_d": {      "type": "string"    },    "correct_answer": {      "type": "string",      "enum": [        "A",        "B",        "C",        "D"      ]    },    "numeric_answer": {      "type": "string"    },    "topic": {      "type": "string"    },    "difficulty": {      "type": "string",      "enum": [        "Easy",        "Medium",        "Challenge"      ]    },    "explanation": {      "type": "string"    },    "usage": {      "type": "string",      "enum": [        "test_1",        "test_2",        "test_3",        "practice"      ]    },    "points": {      "type": "number",      "default": 1    },    "image_url": {      "type": "string"    }  },  "required": [    "question_text",    "usage"  ]}